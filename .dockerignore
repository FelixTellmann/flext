# Trims the Docker build context. Everything listed here is either regenerated inside the image,
# never read by the build, or must not enter an image layer at all.

# Secrets. This repo has a real .env at the root; `COPY . .` in the build stage would bake it into
# a layer that anyone with the image can read back. The build reads no environment (see Dockerfile),
# so excluding these costs nothing.
.env
.env.*

# VCS metadata — 127MB, and no build step shells out to git.
.git
.gitignore

# Regenerated by `bun install` / `bun run build`, never read from the context.
node_modules
.output
.nitro
.tanstack
dist
*.tsbuildinfo

# Generated route tree — vite regenerates it during the build.
src/routeTree.gen.ts

# Docs the build never reads. docs/testing alone carries ~70 parity screenshots.
docs

# Local-only tooling, scratch and editor state.
.claude
.superpowers
tmp
.idea
*.iml

# Screenshots committed at the repo root.
*.png
*.jpg
