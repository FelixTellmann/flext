{
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(npm list:*)",
      "Bash(curl -s http://localhost:3000/)",
      "Read",
      "Glob",
      "Grep",
      "Bash(bun run:*)",
      "Bash(bun install)",
      "Bash(bun add:*)",
      "Bash(bun remove:*)",
      "Bash(bunx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "WebSearch",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:biomejs.dev)",
      "WebFetch(domain:orpc.unnoq.com)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git add -A)",
      "Bash(git add -A:*)",
      "Bash(git add .)",
      "Bash(git add --all)",
      "Bash(git add --all:*)",
      "Bash(git checkout .)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git clean:*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force)",
      "Bash(git push --force:*)",
      "Bash(git push -f)",
      "Bash(git push -f:*)",
      "Bash(sudo:*)",
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master)",
      "Bash(git push origin master:*)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin master)",
      "Bash(git push --set-upstream origin main)",
      "Bash(git push --set-upstream origin master)"
    ]
  },
  "defaultMode": "acceptEdits"
}
